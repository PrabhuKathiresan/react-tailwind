{
  "name": "Button",
  "description": "",
  "props": [
    {
      "name": "theme",
      "type": "enum",
      "raw": "ButtonTheme",
      "enumValues": ["primary", "secondary", "danger", "success", "warning"],
      "required": false,
      "defaultValue": "\"primary\"",
      "description": "Controls button theme (color palette)."
    },
    {
      "name": "variant",
      "type": "enum",
      "raw": "ButtonVariant",
      "enumValues": ["default", "outlined", "plain"],
      "required": false,
      "defaultValue": "\"default\"",
      "description": "Controls the visual styling of the button."
    },
    {
      "name": "size",
      "type": "enum",
      "raw": "ButtonSize",
      "enumValues": ["xs", "sm", "md", "lg"],
      "required": false,
      "defaultValue": "\"md\"",
      "description": "Controls padding, font size, spacing."
    },
    {
      "name": "leftIcon",
      "type": "ReactNode",
      "raw": "ReactNode",
      "enumValues": null,
      "required": false,
      "defaultValue": null,
      "description": "Icon displayed on the left side of button text."
    },
    {
      "name": "rightIcon",
      "type": "ReactNode",
      "raw": "ReactNode",
      "enumValues": null,
      "required": false,
      "defaultValue": null,
      "description": "Icon displayed on the right side of button text."
    },
    {
      "name": "fullWidth",
      "type": "boolean",
      "raw": "boolean",
      "enumValues": null,
      "required": false,
      "defaultValue": "false",
      "description": "Stretches button to share 100% of container width."
    },
    {
      "name": "loading",
      "type": "boolean",
      "raw": "boolean",
      "enumValues": null,
      "required": false,
      "defaultValue": null,
      "description": "If true, shows a Loader inside the button."
    },
    {
      "name": "loadingText",
      "type": "string",
      "raw": "string",
      "enumValues": null,
      "required": false,
      "defaultValue": "\"\"",
      "description": "Optional text to display next to the loader."
    },
    {
      "name": "rounded",
      "type": "boolean",
      "raw": "boolean",
      "enumValues": null,
      "required": false,
      "defaultValue": "false",
      "description": "Applies 50% border radius, producing a pill-shaped button."
    },
    {
      "name": "iconOnly",
      "type": "boolean",
      "raw": "boolean",
      "enumValues": null,
      "required": false,
      "defaultValue": "false",
      "description": "Indicates that the button only contains an icon."
    },
    {
      "name": "noOutlineOnFocus",
      "type": "boolean",
      "raw": "boolean",
      "enumValues": null,
      "required": false,
      "defaultValue": "false",
      "description": "Prevents outline styles on keyboard focus."
    },
    {
      "name": "type",
      "type": "enum",
      "raw": "\"button\" | \"submit\" | \"reset\"",
      "enumValues": ["button", "submit", "reset"],
      "required": false,
      "defaultValue": null,
      "description": "The HTML button type. Only valid when rendering as <button>."
    },
    {
      "name": "as",
      "type": "ElementType",
      "raw": "ElementType",
      "enumValues": null,
      "required": false,
      "defaultValue": "\"button\"",
      "description": "The element or component to render."
    }
  ]
}
