      "defaultValue": "false",
      "description": "Make card hoverable (adds subtle background transitions)"
    },
    {
      "name": "clickable",
      "type": "boolean",
      "raw": "boolean",
      "enumValues": null,
      "required": false,
      "defaultValue": "false",
